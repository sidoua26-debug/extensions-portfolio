# Cloudflare Pages Custom Headers Configuration
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/

# Site-wide baseline security headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none';

# HTML documents: require freshness revalidation on updates
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/privacy.html
  Cache-Control: no-cache, must-revalidate

/404.html
  Cache-Control: no-cache, must-revalidate

/word-to-latex-converter/*
  Cache-Control: no-cache, must-revalidate


# Core portfolio UI scripts & styles: require freshness revalidation on updates
/assets/js/site.js
  Cache-Control: no-cache, must-revalidate

/assets/css/styles.css
  Cache-Control: no-cache, must-revalidate

# Converter JavaScript bundles (stable non-fingerprinted filenames: 1-hour cache with must-revalidate)
/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Portfolio CSS stylesheets (stable non-fingerprinted filenames: 1-hour cache with must-revalidate)
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

# WebAssembly engine asset (stable non-fingerprinted filename: 1-hour cache with must-revalidate)
/assets/wasm/pandoc.wasm.gz
  Cache-Control: public, max-age=3600, must-revalidate

# Font files: immutable long-term caching
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Search engine discovery files
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400


# Static images and brand assets: 30-day cache
/assets/icons/*
  Cache-Control: public, max-age=2592000, immutable

/assets/screenshots/*
  Cache-Control: public, max-age=2592000, immutable

/assets/og/*
  Cache-Control: public, max-age=2592000, immutable

/assets/promo/*
  Cache-Control: public, max-age=2592000, immutable
